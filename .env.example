# Env of apps/server. Copy this file next to the server's package.json for dev; production keeps its own file on the
# server (never in git).
# NODE_ENV=production on the server; development by default.
NODE_ENV=development
# Loopback port of the API (dev: 5320; the web dev server on 5321 proxies /api, /auth and /healthz to it).
PORT=5320
# Public origin of the app; the sign-in callback is PUBLIC_URL/auth/callback. Dev: the web dev server.
PUBLIC_URL=http://localhost:5321
# Postgres connection string. Unset: embedded PGlite under .data/pglite (dev only; refused in production).
DATABASE_URL=
# hoandat.com account (auth-next). Sign-in stays off until AUTH_CLIENT_SECRET is set.
AUTH_ISSUER=https://auth.hoandat.com
# kb-web in production; kb-web-dev on a developer's machine (callback http://localhost:5321/auth/callback).
AUTH_CLIENT_ID=kb-web-dev
# Secret of that client (the IdP's KB_WEB_CLIENT_SECRET or KB_WEB_DEV_CLIENT_SECRET). At least 32 characters.
AUTH_CLIENT_SECRET=
# IdP subs of the admins, comma-separated (the `sub` of the hoandat.com account). No other way to become admin.
ADMIN_SUBS=
# Meilisearch of kb. Dev: `pnpm meili` (127.0.0.1:5322, same dev key as below). Unset: search sync is off and the
# server still runs; required in production (Docker on the server, loopback only).
MEILI_URL=http://127.0.0.1:5322
# At least 16 characters. Dev: the default of scripts/meili-dev.ts; production: a long random key.
MEILI_MASTER_KEY=kb-dev-meili-master-key
