{
  "name": "@kb/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "bundle": "tsx bundle.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "reindex": "tsx --env-file-if-exists=.env src/cli/reindex.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "import:hoc-cloud": "tsx --env-file-if-exists=.env src/cli/import-hoc-cloud.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~5.6.205",
    "pg": "^8.23.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2"
  }
}
